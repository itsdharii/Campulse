# Required for live OpenAI-powered chat
OPENAI_API_KEY=your_openai_api_key_here

# Model name can be changed without editing Python source
OPENAI_MODEL=gpt-6-luna

# SQLite path; relative paths are resolved from the directory you run Python in
CREWSYNC_DB=./crewsync.db

# Safety/performance limits
CREWSYNC_MAX_TOOL_CALLS=8
CREWSYNC_MAX_HISTORY_MESSAGES=20
